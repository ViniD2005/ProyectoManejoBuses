# Clave para firmar los tokens (cadena larga y aleatoria)
JWT_SECRET=cambia_esta_clave_por_una_larga_y_aleatoria
# GC-12 - Correo. En desarrollo se usa MailHog (http://localhost:8025)
# Con Docker no toques esto: docker-compose.yml ya usa SMTP_HOST=mailhog
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-responder@pasajes.ec
